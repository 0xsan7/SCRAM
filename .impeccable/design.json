  "components": [
    {
      "name": "Ordinary action",
      "kind": "button",
      "refersTo": "button-default",
      "description": "The outlined action used for pagination and recovery; disabled and keyboard-focus treatments are retained.",
      "html": "<button type=\"button\" class=\"ds-button\">Next</button>",
      "css": ".ds-button{font-family:var(--body,Manrope,system-ui,sans-serif);font-size:14px;line-height:1.65;border:1px solid var(--line,#2b2f35);background:var(--surface,#121416);color:var(--text,#eceef0);border-radius:7px;padding:8px 12px;min-height:40px;cursor:pointer}.ds-button:hover{background:var(--hover,#1b1e22);border-color:#5a616c}.ds-button:focus-visible{outline:2px solid var(--accent,#f4ba63);outline-offset:4px;}.ds-button:disabled{cursor:default;opacity:.42}.ds-button:disabled:hover{background:var(--surface,#121416);border-color:var(--line,#2b2f35)}@media(prefers-reduced-motion:no-preference){.ds-button{transition:background-color .14s ease-out,border-color .14s ease-out,color .14s ease-out}}"
    },
    {
      "name": "Native report file action",
      "kind": "input",
      "refersTo": "file-button",
      "description": "The native local-report picker is the strongest light action.",
      "html": "<label class=\"ds-file-label\" for=\"ds-report-file\">Open a local report</label><input class=\"ds-file\" id=\"ds-report-file\" type=\"file\" accept=\".json,application/json\">",
      "css": ".ds-file-label{display:block;font-family:var(--body,Manrope,system-ui,sans-serif);font-size:12px;font-weight:700;color:var(--text,#eceef0);margin-bottom:8px}.ds-file{width:100%;font-family:var(--body,Manrope,system-ui,sans-serif);font-size:11px;color:var(--muted,#a5acb6);overflow:hidden}.ds-file::file-selector-button{background:#e5e7eb;color:#111214;border:0;border-radius:6px;font:600 12px var(--body,Manrope,system-ui,sans-serif);padding:11px 12px;margin-right:8px;margin-bottom:8px;cursor:pointer}.ds-file::file-selector-button:hover{background:#fff}.ds-file:focus-visible{outline:2px solid var(--accent,#f4ba63);outline-offset:4px;}"
    },
    {
      "name": "Selected example choice",
      "kind": "button",
      "refersTo": "example-selected",
      "description": "Report selection is distinct from the report\u2019s failed-policy status.",
      "html": "<button class=\"ds-example\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-dot\" aria-hidden=\"true\"></span><span><strong>A new finding</strong><small>Policy failed</small></span><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"m8 5 5 5-5 5\"/></svg></button>",
      "css": ".ds-example{display:flex;gap:10px;align-items:center;text-align:left;border:1px solid transparent;background:transparent;padding:11px 8px;width:100%;border-radius:8px;font-family:var(--body,Manrope,system-ui,sans-serif);color:var(--text,#eceef0);cursor:pointer}.ds-example:hover{background:var(--hover,#1b1e22);border-color:#5a616c}.ds-example[aria-pressed=true]{background:#20201c;border-color:#4b4334}.ds-example strong{display:block;font-size:12px;font-weight:600}.ds-example[aria-pressed=true] strong{color:var(--accent,#f4ba63)}.ds-example small{display:block;font-size:11px;color:var(--muted,#a5acb6);margin-top:3px}.ds-dot{width:6px;height:6px;border-radius:50%;background:var(--red,#ff9d9d);flex-shrink:0}.ds-example svg{width:16px;height:16px;margin-left:auto;color:var(--muted,#a5acb6);fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.ds-example:focus-visible{outline:2px solid var(--accent,#f4ba63);outline-offset:4px;}@media(max-width:720px){.ds-example{padding:9px 7px;gap:6px;align-items:flex-start;border-color:var(--line,#2b2f35);min-height:73px}.ds-example strong,.ds-example small{font-size:11px;line-height:1.5}.ds-example small{margin-top:4px}.ds-dot{margin-top:6px}.ds-example svg{display:none}}"
    },
    {
      "name": "Inventory search",
      "kind": "input",
      "refersTo": "search",
      "description": "A surface-colored search control with an amber focus-within border.",
      "html": "<label class=\"ds-search\" for=\"ds-search\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"8.5\" cy=\"8.5\" r=\"5.5\"/><path d=\"m13 13 4 4\"/></svg><input id=\"ds-search\" type=\"search\" aria-label=\"Search name, PURL or finding\" placeholder=\"Search name, PURL or finding\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;border:1px solid var(--line,#2b2f35);border-radius:7px;padding-left:11px;min-width:0;background:var(--surface,#121416)}.ds-search svg{width:17px;height:17px;color:var(--muted,#a5acb6);fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-search input{border:0;background:none;color:var(--text,#eceef0);width:100%;min-width:0;padding:10px 7px 10px 0;font-family:var(--body,Manrope,system-ui,sans-serif);font-size:11px;caret-color:var(--accent,#f4ba63)}.ds-search input::placeholder{color:var(--muted,#a5acb6)}.ds-search:focus-within{border-color:var(--accent,#f4ba63)}.ds-search input:focus-visible{outline:2px solid var(--accent,#f4ba63);outline-offset:4px;outline-offset:1px}@media(max-width:720px){.ds-search input{font-size:12px;padding:12px 8px 12px 0}}"
    },
    {
      "name": "Dependency filter",
      "kind": "input",
      "description": "Native select uses the same outlined surface as search.",
      "html": "<select class=\"ds-filter\" aria-label=\"Filter dependencies\"><option>All dependencies</option><option>With findings</option><option>With new findings</option><option>Direct dependencies</option></select>",
      "css": ".ds-filter{border:1px solid var(--line,#2b2f35);border-radius:7px;padding:10px 23px 10px 10px;background:var(--surface,#121416);color:var(--text,#eceef0);max-width:170px;font-family:var(--body,Manrope,system-ui,sans-serif);font-size:11px;min-height:40px;cursor:pointer}.ds-filter:focus-visible{outline:2px solid var(--accent,#f4ba63);outline-offset:4px;}@media(max-width:720px){.ds-filter{width:100%;max-width:none;min-height:42px}}"
    },
    {
      "name": "Severity tag",
      "kind": "chip",
      "refersTo": "severity-tag",
      "description": "A noninteractive finding label; the status remains explicit in text.",
      "html": "<span class=\"ds-severity\">New \u00b7 high \u00b7 CVSS 8.2</span>",
      "css": ".ds-severity{display:inline-block;border:1px solid var(--line,#2b2f35);border-radius:4px;padding:2px 6px;font-family:var(--body,Manrope,system-ui,sans-serif);font-size:11px;color:var(--red,#ff9d9d);white-space:nowrap}"
    },
    {
      "name": "Policy evidence panel",
      "kind": "card",
      "refersTo": "policy",
      "description": "A semantic failed-policy panel with its reason visible below the outcome.",
      "html": "<section class=\"ds-policy\"><div class=\"ds-policy-heading\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6m0 3h.01\"/></svg><div><h2>Policy failed</h2><p>The configured gate did not pass. Review its reasons and the evidence below.</p></div></div><ul class=\"ds-evidence\"><li>New findings were reported against the baseline.</li></ul></section>",
      "css": ".ds-policy{padding:23px 25px;background:var(--surface,#121416);border:1px solid var(--line,#2b2f35);border-radius:var(--radius,12px);font-family:var(--body,Manrope,system-ui,sans-serif);}.ds-policy-heading{display:flex;align-items:flex-start;gap:13px}.ds-policy-heading svg{color:var(--red,#ff9d9d);width:25px;height:25px;margin-top:1px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-policy h2{font-family:var(--display,Sora,system-ui,sans-serif);font-weight:500;line-height:1.3;letter-spacing:-.02em;font-size:20px;color:var(--red,#ff9d9d);margin:0}.ds-policy p{color:var(--muted,#a5acb6);margin:7px 0 0;max-width:75ch;font-size:12px;line-height:1.65}.ds-evidence{padding-left:19px;margin:15px 0 0 38px;color:#d2d6dc;font-size:12px;line-height:1.65;overflow-wrap:anywhere;max-width:90ch}@media(max-width:720px){.ds-policy{padding:20px 17px}.ds-policy h2{font-size:18px}.ds-policy-heading{gap:10px}.ds-policy p,.ds-evidence{font-size:11px}.ds-policy-heading svg{width:22px;height:22px}.ds-evidence{margin-left:8px}}"
    },
    {
      "name": "Component inspector",
      "kind": "card",
      "refersTo": "inspector",
      "description": "The adjacent detail surface retains package identity before its evidence sections.",
      "html": "<section class=\"ds-inspector\"><div class=\"ds-heading\"><h2>Component inspector</h2><span>Selected dependency</span></div><h3 class=\"ds-detail-title\">example-package</h3><p class=\"ds-purl\">pkg:npm/example-package@1.2.0</p><dl class=\"ds-facts\"><div><dt>Version</dt><dd>1.2.0</dd></div><div><dt>Relationship</dt><dd>Direct</dd></div><div><dt>License</dt><dd>Not provided</dd></div></dl></section>",
      "css": ".ds-inspector{padding:22px;background:var(--surface,#121416);color:var(--text,#eceef0);border:1px solid var(--line,#2b2f35);border-radius:var(--radius,12px);font-family:var(--body,Manrope,system-ui,sans-serif);}.ds-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:23px}.ds-heading h2{font:500 15px/1.3 var(--display,Sora,system-ui,sans-serif);letter-spacing:-.02em;margin:0}.ds-heading span{font-size:11px;color:var(--muted,#a5acb6)}.ds-detail-title{font:500 19px/1.3 var(--display,Sora,system-ui,sans-serif);overflow-wrap:anywhere;margin:0 0 8px}.ds-purl{color:var(--muted,#a5acb6);font:11px/1.8 ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere;margin:0}.ds-facts{display:flex;flex-wrap:wrap;gap:10px 20px;padding:17px 0;border-bottom:1px solid var(--line,#2b2f35);margin:0 0 22px}.ds-facts div{font-size:11px}.ds-facts dt{color:var(--muted,#a5acb6);margin-bottom:3px}.ds-facts dd{margin:0}@media(max-width:720px){.ds-inspector{padding:19px 17px}.ds-heading h2{font-size:14px}}"
    },
    {
      "name": "Selected inventory row",
      "kind": "custom",
      "refersTo": "inventory-row-selected",
      "description": "The warm row, amber name and inset marker connect inventory selection to the inspector.",
      "html": "<table class=\"ds-table\"><tbody><tr class=\"ds-selected\"><td><button class=\"ds-row-select\" type=\"button\" aria-pressed=\"true\">example-package</button><div class=\"ds-meta\">1.2.0 \u00b7 Direct</div></td><td class=\"ds-ecosystem\">npm</td><td>1<span class=\"ds-row-severity\">High advisory</span></td></tr></tbody></table>",
      "css": ".ds-table{border-collapse:collapse;width:100%;text-align:left;font-family:var(--body,Manrope,system-ui,sans-serif);color:var(--text,#eceef0);font-variant-numeric:tabular-nums}.ds-table td{padding:15px 12px;border-bottom:1px solid #23262b;vertical-align:top;font-size:11px}.ds-selected{background:#1b1c1a}.ds-selected td:first-child{box-shadow:inset 1px 0 var(--accent,#f4ba63)}.ds-row-select{display:block;text-align:left;padding:0;border:0;background:transparent;min-height:26px;color:var(--accent,#f4ba63);font-family:var(--body,Manrope,system-ui,sans-serif);font-size:12px;font-weight:650;max-width:100%;overflow-wrap:anywhere;cursor:pointer}.ds-row-select:hover{background:transparent;color:var(--accent,#f4ba63)}.ds-row-select:focus-visible{outline:2px solid var(--accent,#f4ba63);outline-offset:4px;}.ds-meta{font-size:11px;color:var(--muted,#a5acb6);margin-top:3px;overflow-wrap:anywhere}.ds-ecosystem{color:#c1c9d5;white-space:nowrap}.ds-row-severity{display:block;font-size:11px;margin-top:4px;color:var(--red,#ff9d9d)}@media(max-width:720px){.ds-table td{padding:14px 9px}.ds-row-select{font-size:11px}}"
    },
    {
      "name": "Application header navigation",
      "kind": "nav",
      "description": "A quiet brand/home link and explicit external source link frame the report viewer.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Application\"><a class=\"ds-brand\" href=\"./\"><svg viewBox=\"0 0 28 28\" aria-hidden=\"true\"><path d=\"M14 2 24 6v8c0 6-10 12-10 12S4 20 4 14V6Z\"/><path d=\"m9 14 3 3 7-7\"/></svg><span>SCRAM</span><span class=\"ds-divider\"></span><span class=\"ds-app-name\">Report viewer</span></a><a class=\"ds-source\" href=\"https://github.com/0xsan7/SCRAM\" target=\"_blank\" rel=\"noopener noreferrer\">Source code <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M5 15 15 5M5 5h10v10\"/></svg></a></nav>",
      "css": ".ds-nav{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 32px;border-bottom:1px solid var(--line,#2b2f35);background:var(--page,#0b0c0e);color:var(--text,#eceef0);font-family:var(--body,Manrope,system-ui,sans-serif);}.ds-nav a{text-decoration:none}.ds-nav a:hover{color:var(--accent,#f4ba63)}.ds-nav a:focus-visible{outline:2px solid var(--accent,#f4ba63);outline-offset:4px;}.ds-brand{display:flex;align-items:center;gap:12px;font-family:var(--display,Sora,system-ui,sans-serif);font-size:18px;font-weight:600;letter-spacing:-.03em;color:inherit}.ds-brand svg{width:28px;height:28px;color:var(--accent,#f4ba63)}.ds-nav svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-divider{width:1px;height:22px;background:var(--line,#2b2f35);margin:0 5px}.ds-app-name{font-family:var(--body,Manrope,system-ui,sans-serif);font-size:13px;font-weight:500;letter-spacing:0;color:var(--muted,#a5acb6)}.ds-source{font-size:12px;color:var(--muted,#a5acb6)}.ds-source svg{width:16px;height:16px;vertical-align:middle;margin-left:8px}@media(max-width:720px){.ds-nav{height:65px;padding:0 20px}.ds-brand{font-size:16px;gap:9px}.ds-divider{margin:0 2px}.ds-app-name{font-size:11px}.ds-source{font-size:0}.ds-source svg{width:20px;height:20px}}"
    }
  ],
  "narrative": {
    "northStar": "Dependency registry",
    "overview": "A quiet, dark review desk: ruled dependency rows sit beside a component inspector, with report provenance and policy evidence above them. The interface gives reading, comparison and selection more weight than decoration. The registry metaphor is the implemented direction recorded in `docs/report-viewer-design.md` (Operate mode, grounded candidate 6); it is descriptive language for this build.\n\nThe user selected a dark interface matching the portfolio. Sora headings and Manrope text reuse its self-hosted font assets. Specific colors, dimensions, component arrangements and the rules below record current implementation patterns; they are not claims of separate user approval. There is no approved image comp. This document covers `web/`, not the scanner's terminal output or the root portfolio.",
    "keyCharacteristics": [
      "Near-black surfaces separated by fine rules and restrained tonal changes.",
      "Amber selection and focus, with explicit status words alongside status colors.",
      "Compact, tabular report facts and wrapping identifiers.",
      "A report chooser, inventory and inspector that stack as space narrows.",
      "Immediate report-state changes and optional short control transitions."
    ],
    "rules": [
      {
        "name": "The Status Has Words Rule",
        "body": "Preserve the visible policy, severity and example labels when using status color; a dot or color alone does not carry the result.",
        "section": "colors"
      },
      {
        "name": "The Identifier Rule",
        "body": "Reserve monospace for actual identifiers, versions where represented as code, and commands; retain Manrope for human explanations.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Separate evidence groups with the existing line and surface vocabulary; keep row selection legible through both the warm background and inset marker.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the near-black surface hierarchy, fine rules and Sora/Manrope pairing already implemented.",
      "**Do** keep provenance, policy explanations and missing-evidence warnings visible before interpreting scores.",
      "**Do** pair semantic colors with explicit words and preserve the amber keyboard focus outline.",
      "**Do** preserve identifier wrapping, responsive stacking and local table overflow.",
      "**Do** keep selected report and selected dependency states distinguishable from policy outcomes."
    ],
    "donts": [
      "**Don't** turn a passed policy or zero known findings into a visual claim of repository safety.",
      "**Don't** replace unknown baseline values with zeros or successful status decoration.",
      "**Don't** turn these extracted implementation details into claims of user-approved composition or an approved image comp.",
      "**Don't** add decorative graph data, artificial live activity or entrance motion to this saved-report registry."
    ]
  }
}
